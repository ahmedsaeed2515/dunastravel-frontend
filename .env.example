# ========================================
# Dunas Travel Frontend - Environment Variables
# ========================================
# Copy this file to .env.production or .env.local and fill in the values.
# Configure this value in the hosting provider's production environment.

# --- API Configuration ---
# The URL pointing to your backend API. For local development, this is usually http://localhost:5000/api
# For production, use the public VPS API.
VITE_API_URL=https://api.dunas-travel.com/api

# Online payment configuration is server-side only. Do not place GetPayIn
# credentials or webhook secrets in Vite environment variables.
