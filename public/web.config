<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- 1. 301 Permanent Redirects for Old Site Home Language Variants -->
        <rule name="Redirect Legacy index-Spa" stopProcessing="true">
          <match url="^index-Spa\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=es" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy index-Por" stopProcessing="true">
          <match url="^index-Por\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=pt" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy index-Ita" stopProcessing="true">
          <match url="^index-Ita\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=it" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy index-Arb" stopProcessing="true">
          <match url="^index-Arb\.html$" ignoreCase="true" />
          <action type="Redirect" url="/?lang=ar" redirectType="Permanent" />
        </rule>

        <!-- 2. 301 Permanent Redirects for Old Static HTML Pages -->
        <rule name="Redirect Legacy About" stopProcessing="true">
          <match url="^about(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/about" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Contact" stopProcessing="true">
          <match url="^contact(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/contact" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Hotels" stopProcessing="true">
          <match url="^hotels(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/hotels" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Gallery" stopProcessing="true">
          <match url="^gallery(-[a-zA-Z]+)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/gallery" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Cruises and Tours" stopProcessing="true">
          <match url="^(cruises|jordan|cleopatra|ramsesii|nefertaria|nefertarib|nefertiti|akhenaton|amon|hathor|hatshpsut|amenhoteb|zoser)(-.*)?\.html$" ignoreCase="true" />
          <action type="Redirect" url="/tours" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Legacy Services" stopProcessing="true">
          <match url="^(services|pricing)\.html$" ignoreCase="true" />
          <action type="Redirect" url="/services" redirectType="Permanent" />
        </rule>

        <!-- 3. SPA Fallback Routing for Modern Application -->
        <rule name="SPA Fallback Routing" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".env.production" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".vtt" />
      <mimeMap fileExtension=".vtt" mimeType="text/vtt" />
    </staticContent>
  </system.webServer>
</configuration>
